# Common Parts Access environment variables
# Copy this file to .env.local and replace every placeholder value.

# Required for local app runtime

# Public Supabase project URL from Supabase Dashboard -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here

# Publishable key (sb_publishable_...) from Supabase Dashboard -> Settings -> API Keys.
# Safe to expose client-side: RLS applies. Inlined at build time, so it must be set before the build.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Secret key (sb_secret_...) from Supabase Dashboard -> Settings -> API Keys.
# Server-only: it bypasses RLS. Never prefix it with NEXT_PUBLIC_ and never expose it client-side.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Canonical app URL used by app metadata; if omitted, code falls back to localhost.
NEXT_PUBLIC_APP_URL=your_app_url_here

# Optional access control

# Comma-separated Supabase user ids allowed to read the curation data (/dashboard/search-demand); server-only, unset means nobody.
CURATOR_USER_IDS=your_curator_user_ids_here

# Optional source integrations

# Thingiverse app token (App Token of an app registered at thingiverse.com/developers).
# Enables the Thingiverse pre-fill and image import in the publish flow; unset keeps
# platform detection only and sends no request to Thingiverse.
# Server-only: never prefix it with NEXT_PUBLIC_.
THINGIVERSE_APP_TOKEN=your_thingiverse_app_token_here

# Optional feature flags (set true or false; defaults to false when unset)

# Enables premium-related UI features.
NEXT_PUBLIC_ENABLE_PREMIUM=your_true_or_false_here

# Enables analytics-related UI features.
NEXT_PUBLIC_ENABLE_ANALYTICS=your_true_or_false_here

# Shows comments, likes and collections in the UI (off in production; build-time, needs a rebuild).
NEXT_PUBLIC_ENABLE_SOCIAL_FEATURES=your_true_or_false_here

# Enables ratings-related UI features.
NEXT_PUBLIC_ENABLE_RATINGS=your_true_or_false_here

# Enables social-login-related UI features.
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=your_true_or_false_here

# Runtime environment name used by framework/runtime checks.
NODE_ENV=your_node_env_here

# Optional edge function and automation variables (required for feedback triage workflow)

# Mistral API key used by triage automation and docs workflow.
MISTRAL_API_KEY=your_mistral_api_key_here

# GitHub token used by automation that creates or updates GitHub issues.
GITHUB_TOKEN=your_github_token_here

# GitHub repository slug in owner/repo format used by triage automation.
GITHUB_REPO=your_github_owner_slash_repo_here

# Supabase project URL for edge functions (typically same as NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=your_supabase_project_url_here

# Shared bearer secret used by the triage webhook caller and receiver.
# A random value of its own, never a Supabase API key.
WEBHOOK_SECRET=your_webhook_secret_here

# The triage-feedback Edge Function reads its secret key from SUPABASE_SECRET_KEYS,
# which the Supabase platform provides; it is not set by hand.
